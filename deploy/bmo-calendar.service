# Generated from bmo-app.toml by bmo-app-sdk's bmo-app-declare.
# The bmo-calendar service, run from its deploy tree.
[Unit]
Description=bmo-calendar: dated events kept in the brain, their alarms told to the supervisor
After=network-online.target
# Without its deployed settings the service has no credential, so it does not
# start where the deployment wrote none.
ConditionPathExists=%h/.local/share/bmo/data/env/calendar.toml

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-calendar/deploy
ExecStart=%h/.local/share/bmo-calendar/deploy/bin/bmo-calendar serve
Restart=always
RestartSec=2
# A stop waits for the service to end on its own, however long its open streams and
# in-hand requests take; it is never escalated to a kill.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# The repository's one service: stopped, restarted and watched by every deployment, which waits on its health.
X-BMO-Deploy=bot
